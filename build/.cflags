CC=clang-cl
CFLAGS=--target=x86_64-pc-windows-msvc -fuse-ld=lld-link -imsvc/opt/winsdk/crt/include -imsvc/opt/winsdk/sdk/include/10.0.26100/ucrt -imsvc/opt/winsdk/sdk/include/10.0.26100/um -imsvc/opt/winsdk/sdk/include/10.0.26100/shared -I. -I./src -I./snes -I./third_party -I/opt/windows-libs/SDL2/include -I/opt/windows-libs/SDL2/include/SDL2 /MT /O2 /DNDEBUG /DSDL_MAIN_HANDLED /DUNICODE /D_UNICODE /DWIN32 /D_WIN32 /DSYSTEM_VOLUME_MIXER_AVAILABLE=0 -fms-compatibility -fms-compatibility-version=19.37 -Wno-unused-command-line-argument
TARGET_OS=windows